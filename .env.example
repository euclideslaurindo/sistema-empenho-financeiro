# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=empenho

# JWT Secret for authentication
JWT_SECRET=your-secret-key-here

# Application URL (used for redirects and links)
APP_URL=http://localhost:3000

# Setup Route Configuration (DEV ONLY - automatic disable in production)
# Set to 'true' to enable GET /api/setup route that creates initial admin user and system tables
ENABLE_SETUP=false

# Admin initial password for setup route (fallback is 'Mudar@123' if not set)
ADMIN_INITIAL_PASSWORD=

# Google Gemini API Key (optional, only needed if using AI features)
GEMINI_API_KEY=
