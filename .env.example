# Banco de dados (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=empenho

# Chave que assina o token de login (obrigatória: use um valor longo e aleatório)
JWT_SECRET=

# Endereço da aplicação (usado em links e redirecionamentos)
APP_URL=http://localhost:3000

# Só para os testes de ponta a ponta (e2e/global-setup.ts): cria o usuário admin
# num banco de teste LOCAL. Nunca use contra o banco compartilhado.
ENABLE_SETUP=false
ADMIN_INITIAL_PASSWORD=
